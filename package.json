{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Personal site of Danil Zablotsky, design engineer: a static Next.js app served by Caddy.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/compress.ts",
    "preview": "python3 scripts/serve.py",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.4.3",
    "next-intl": "4.14.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
